# makefile.init — persistent build flags for MRS (MounRiver Studio).
# This file is included by obj/makefile and build/makefile before any
# auto-generated rules, so flags defined here are always present even
# after MRS regenerates subdir.mk files.
#
# MRS includes this via:  -include ../makefile.init  (from inside obj/ or build/)

# Feature flags are owned by build/makefile so USB_WORK_MODE can derive a
# consistent descriptor/endpoint profile before every source file is compiled.
